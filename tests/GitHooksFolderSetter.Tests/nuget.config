<?xml version="1.0" encoding="utf-8"?>
<!--
  The test project itself only needs nuget.org (xunit, test sdk).
  Consumer projects built by the tests get their own nuget.config at runtime,
  with the local feed path supplied via the GHFS_PKG_DIR environment variable
  set by pack-and-test.sh.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
