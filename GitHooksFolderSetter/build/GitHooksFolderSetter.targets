<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GitCmd>git</GitCmd>
    <SetMarkerName>git-hook-folder.set</SetMarkerName>

    <!-- Skip in CI / container / design-time / opt-out environments -->
    <GitHooksFolderSetterSkip Condition="'$(GitHooksFolderSetterDisable)' == 'true'">true</GitHooksFolderSetterSkip>
    <GitHooksFolderSetterSkip Condition="'$(CI)' != ''">true</GitHooksFolderSetterSkip>
    <GitHooksFolderSetterSkip Condition="'$(TF_BUILD)' != ''">true</GitHooksFolderSetterSkip>
    <GitHooksFolderSetterSkip Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' != ''">true</GitHooksFolderSetterSkip>
    <GitHooksFolderSetterSkip Condition="'$(DesignTimeBuild)' == 'true'">true</GitHooksFolderSetterSkip>
    <GitHooksFolderSetterSkip Condition="'$(GitHooksFolderSetterSkip)' == ''">false</GitHooksFolderSetterSkip>

    <!--
      Fast path: search for the marker file inside the .git directory above
      the project.  System.IO.Path.Combine produces the OS-native separator so
      GetDirectoryNameOfFileAbove works on both Windows and macOS/Linux.
      The search string is  .git<sep>git-hook-folder.set  which only matches
      when .git is a real directory (not a worktree/submodule file).
    -->
    <_MarkerSearch Condition="!$(GitHooksFolderSetterSkip)">$([System.IO.Path]::Combine('.git', '$(SetMarkerName)'))</_MarkerSearch>
    <_MarkerRoot Condition="!$(GitHooksFolderSetterSkip)">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '$(_MarkerSearch)'))</_MarkerRoot>
    <_MarkerPath Condition="'$(_MarkerRoot)' != ''">$([System.IO.Path]::Combine('$(_MarkerRoot)', '.git', '$(SetMarkerName)'))</_MarkerPath>
    <_MarkerContent Condition="'$(_MarkerPath)' != '' and Exists('$(_MarkerPath)')">$([System.IO.File]::ReadAllText('$(_MarkerPath)').Trim())</_MarkerContent>

    <!--
      Skip the entire target when the marker already records the current
      HooksPath.  Property evaluation costs ~1.6 ms; no process is spawned.
    -->
    <GitHooksFolderSetterSkip Condition="'$(_MarkerContent)' == '$(HooksPath)'">true</GitHooksFolderSetterSkip>
  </PropertyGroup>

  <!--
    Single combined target.  Condition is evaluated once; when true the whole
    target body is skipped and no child targets are scheduled.
  -->
  <Target Name="SetHooksFolderTarget"
          BeforeTargets="BeforeBuild"
          Condition="!$(GitHooksFolderSetterSkip)">

    <!-- Slow path: locate .git root via git rev-parse -->
    <Exec Command='$(GitCmd) rev-parse --show-toplevel'
          ConsoleToMSBuild='true'
          IgnoreExitCode='true'>
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitOutput" />
      <Output TaskParameter="ExitCode"      PropertyName="_GitExitCode" />
    </Exec>

    <Warning Condition="'$(_GitExitCode)' != '0'"
             Text="GitHooksFolderSetter: could not locate .git root (git not found or not a git repo). Hooks path was not set." />

    <PropertyGroup Condition="'$(_GitExitCode)' == '0'">
      <_GitRoot>$(_GitOutput.Trim())</_GitRoot>
      <_SlowMarkerPath>$([System.IO.Path]::Combine('$(_GitRoot)', '.git', '$(SetMarkerName)'))</_SlowMarkerPath>
    </PropertyGroup>

    <!-- Set custom hooks folder -->
    <Exec Command='$(GitCmd) config core.hooksPath $(HooksPath)'
          ConsoleToMSBuild='true'
          IgnoreExitCode='true'
          Condition="'$(_GitExitCode)' == '0'">
      <Output TaskParameter="ExitCode" PropertyName="_GitConfigExitCode" />
    </Exec>

    <Warning Condition="'$(_GitExitCode)' == '0' and '$(_GitConfigExitCode)' != '0'"
             Text="GitHooksFolderSetter: git config core.hooksPath failed." />

    <!-- Write marker with HooksPath as content so the fast path can verify it -->
    <WriteLinesToFile File='$(_SlowMarkerPath)'
                      Lines='$(HooksPath)'
                      Overwrite='true'
                      Condition="'$(_GitExitCode)' == '0' and '$(_GitConfigExitCode)' == '0'" />
  </Target>
</Project>
